# Copia este archivo como server/.env y rellena los valores. server/.env NUNCA se sube a git.

NODE_ENV=development
PORT=3001
# URL pública de la web (para los QR de las facturas y los enlaces de WhatsApp)
PUBLIC_URL=http://localhost:3001

# Base de datos Postgres. En Neon/Render añade ?sslmode=require
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require

# Secreto de las sesiones: mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=12

# Administrador inicial: solo se usa si la base de datos no tiene ningún usuario.
# Al entrar por primera vez el panel obliga a cambiar la contraseña.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# Orígenes extra permitidos para escribir en la API (el propio dominio ya está permitido)
ALLOWED_ORIGINS=

# WhatsApp Business (Meta) — developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inventa una cadena larga y ponla igual en Meta (Webhook > Verify token)
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta: sirve para comprobar que el webhook viene de Meta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# Asistente de la web (Google AI Studio)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash-lite

# Gmail en el panel (opcional) — ver README
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=me
