PORT=3001
JWT_SECRET=tu-jwt-secret-aqui
JWT_EXPIRES=7d
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# WhatsApp Business API (Meta)
# Obten estos valores en developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=epk_verify_2026
WHATSAPP_API_VERSION=v19.0

# Google AI (Chatbot)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# Gmail API
# Pasos:
# 1. Crear proyecto en https://console.cloud.google.com
# 2. Habilitar "Gmail API"
# 3. Crear credenciales OAuth 2.0 (tipo "Desktop app")
# 4. Obtener CLIENT_ID y CLIENT_SECRET
# 5. Autorizar una vez para obtener REFRESH_TOKEN (ver doc/abajo)
# 6. Pegar valores aquí
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_USER=me
